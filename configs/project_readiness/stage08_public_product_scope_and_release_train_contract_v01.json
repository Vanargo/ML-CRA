  "cli_contract": {
    "installed_command": "mlcra",
    "packaging_mechanism": "pyproject_project_scripts_console_entry_point",
    "subcommands": [
      {
        "name": "audit",
        "purpose": "validate_inputs_execute_a_registered_claim_audit_and_write_a_new_evidence_bundle",
        "required_options": ["--spec", "--data", "--output-dir"],
        "forbidden_default": "network_access_or_output_overwrite"
      },
      {
        "name": "verify",
        "purpose": "validate_and_recompute_an_existing_evidence_bundle_without_model_fit",
        "required_options": ["--bundle"],
        "forbidden_default": "fit_or_artifact_repair"
      },
      {
        "name": "doctor",
        "purpose": "report_environment_contract_dependency_runtime_and_release_prerequisites_without_fit",
        "required_options": [],
        "forbidden_default": "environment_mutation_or_dependency_installation"
      }
    ],
    "global_options": ["--help", "--version", "--format=text|json", "--no-color"],
    "input_contract": {
      "data": {
        "format": "CSV_compatible_with_RFC_4180_profile",
        "encoding": "UTF-8",
        "header": "required",
        "columns": "nonempty_unique_names",
        "rows": "at_least_one_after_parsing",
        "target": "explicitly_named_and_present",
        "path_policy": "local_regular_file_no_implicit_url"
      },
      "specification": {
        "format": "JSON",
        "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
        "required_fields": ["schema_version", "claim_id", "task_type", "target", "candidate_model", "baseline_model", "primary_metric", "split_protocol", "seeds", "preprocessing_policy"],
        "unknown_fields": "rejected_unless_the_versioned_schema_explicitly_allows_them",
        "executable_payloads": "forbidden"
      },
      "security": {
        "pickle_joblib_cloudpickle_and_arbitrary_python_imports": "forbidden_for_user_supplied_inputs",
        "network": "deny_by_default_and_only_future_explicit_contract_may_enable",
        "secrets": "must_not_be_accepted_or_written_as_claim_parameters"
      }
    },
    "output_contract": {
      "overwrite_policy": "fail_if_output_directory_exists_unless_a_future_explicit_resume_contract_applies",
      "atomicity_policy": "write_to_staging_validate_then_publish_complete_bundle_or_leave_diagnostic_failure_without_claiming_success",
      "required_artifacts": [
        "run_manifest.json",
        "input_validation.json",
        "environment.json",
        "provenance.json",
        "audit_summary.json",
        "verdict.json",
        "warnings.json",
        "artifact_index.json"
      ],
      "manifest_minimum": ["contract_version", "software_version", "command", "input_hashes", "spec_hash", "artifact_hashes", "started_at", "completed_at", "exit_code", "network_attempts"],
      "stdout": "one_human_summary_or_one_json_result_envelope_selected_by_format",
      "stderr": "diagnostics_and_errors_only",
      "success_disclosure": "verdict_scope_limitations_primary_metric_and_output_bundle_path_are_always_present"
    },
    "exit_codes": [
      {"code": 0, "meaning": "contract_valid_execution_completed", "includes": ["supported_verdict", "negative_verdict", "fragile_verdict"]},
      {"code": 2, "meaning": "command_line_usage_or_argument_error", "includes": ["unknown_option", "missing_required_option", "invalid_choice"]},
      {"code": 3, "meaning": "input_or_specification_contract_error", "includes": ["missing_file", "csv_schema_error", "json_schema_error", "unsupported_task_or_model"]},
      {"code": 4, "meaning": "evidence_blocked_or_insufficient_for_a_valid_verdict", "includes": ["missing_required_evidence", "unresolved_provenance", "protocol_precondition_not_met"]},
      {"code": 5, "meaning": "controlled_execution_or_environment_failure", "includes": ["dependency_or_runtime_contract_failure", "fit_failure", "resource_failure"]},
      {"code": 6, "meaning": "internal_invariant_or_bundle_integrity_failure", "includes": ["hash_mismatch", "impossible_aggregate", "partial_publish_detected"]}
    ],
    "diagnostic_contract": {
      "required_fields": ["error_code", "phase", "artifact_or_field", "expected", "actual", "severity", "action_taken", "user_action", "rule_source"],
      "uncaught_traceback_default": "forbidden_in_normal_user_mode",
      "json_mode": "one_machine_readable_error_envelope_on_stderr",
      "text_mode": "plain_russian_or_english_actionable_message_selected_by_locale"
    }
  },
