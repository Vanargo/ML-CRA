    "n_splits": {"minimum": 2, "maximum": 10},
    "minimum_rows": "2_times_n_splits",
    "pairing": "both_models_use_the_same_train_and_test_indices_for_every_seed_and_fold",
    "primary_metric": "root_mean_squared_error",
    "secondary_metrics": ["mean_absolute_error"],
    "metric_direction": "lower_is_better",
