    "candidate": {
      "implementation": "sklearn.ensemble.HistGradientBoostingClassifier",
      "learning_rate": 0.1,
      "max_iter": 100,
      "max_leaf_nodes": 15,
      "min_samples_leaf": 5,
      "l2_regularization": 0.1
    },
    "reported_metrics": [
      "average_precision",
      "roc_auc",
      "f1",
      "balanced_accuracy",
      "log_loss",
      "brier_score"
    ],
    "verdict_categories": {
      "supported": "mean_primary_delta_meets_registered_threshold_and_candidate_wins_every_registered_fold",
      "fragile": "mean_primary_delta_meets_registered_threshold_but_candidate_does_not_win_every_registered_fold",
      "not_supported": "mean_primary_delta_does_not_meet_registered_threshold"
    },
    "scientific_scope_limit": "A verdict is limited to the supplied data, allowlisted models, metric, split count, seeds and threshold; it is not a universal model ranking."
  },
  "output_contract": {
    "publication": "write_complete_staging_directory_then_same_filesystem_atomic_directory_rename",
